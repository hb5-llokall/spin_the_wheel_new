# Use this for any Postgres-compatible database.
# Works with local PostgreSQL, hosted PostgreSQL, and Supabase Postgres.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db

# Optional SSL toggle for hosted providers.
DB_SSL=false
# Time zone for every database session: the wheel's day turns over at midnight here.
# The database server itself runs on UTC.
DB_TIMEZONE=Asia/Kolkata

# API server port.
PORT=3000

# Optional tester numbers for forced rewards and reset.
TESTER_MOBILE_NUMBERS=9500365660,9600692495

# Transfer mode:
# - mock: local success without external provider
# - provider: tries Redash lookup + Dostt upload if keys are set
TRANSFER_MODE=provider

# Optional external transfer integration.
REDASH_API_KEY=replace_with_redash_api_key
REDASH_QUERY_ID=replace_with_redash_query_id
REDASH_QUERY_ID_2=replace_with_redash_query_id_2
REDASH_QUERY_ID_3=replace_with_redash_query_id_3
DOSTT_AUTH_KEY=replace_with_dostt_auth_key
SLACK_WEBHOOK_URL=replace_with_slack_webhook_url

# Admin dashboard credentials (for /admin route).
ADMIN_USERNAME=MariEswar
ADMIN_PASSWORD=replace_with_your_admin_password

# Redash query ID used for admin retry transfers.
RETRY_REDASH_QUERY_ID=17905

# Monitoring alerts Slack webhook (separate from transfer alerts).
MONITOR_SLACK_WEBHOOK_URL=replace_with_monitor_slack_webhook_url

# Recharge gate: nightly in-app job that silently locks rewards (always
# "better luck") for unpaid users past this many unique spin days. The Redash
# query takes no parameters and returns users unpaid since spin launch who have
# transferred at least once (user_id / mobile_no columns).
REDASH_ELIGIBILITY_QUERY_ID=20584
RECHARGE_GATE_DAY_THRESHOLD=5
# Daily in-app run time (IST, HH:MM). RECHARGE_GATE_DRY_RUN=true logs counts without locking anyone.
RECHARGE_GATE_RUN_AT_IST=02:00
RECHARGE_GATE_DRY_RUN=false
# Set to off to disable the in-app scheduler entirely
RECHARGE_GATE_SCHEDULER=on

# Reward engine v1 (docs/spin_reward_handoff/SPEC.md): personalised 5-day plans.
#   off      legacy daily rule (one 10-coin win a day, 50 on every 5th day played)
#   dry_run  everything runs on shadow plans (nightly scoring, a draw on every spin)
#            but players still get the legacy rule
#   on       spins draw from each player's 5-spin-day plan: regular payers scored,
#            one-time payers 15 · 15 · 10 · 25 · 25 plans, unpaid users one such
#            trial and then Better Luck until they recharge
REWARD_ENGINE=off
# Redash query (BigQuery - Dostt) from sql/redash/reward_features_bq.sql, with a
# Date parameter scoring_date. Needed for dry_run and on. Saved as Redash query 20845.
REDASH_REWARD_FEATURES_QUERY_ID=20845
# Nightly job time (IST, HH:MM); runs only when REWARD_ENGINE is dry_run or on
REWARD_SCORING_RUN_AT_IST=03:00
REWARD_SCORING_SCHEDULER=on
# Optional overrides of src/reward-config.js (all reward numbers), e.g. no cap and a higher floor:
# REWARD_CONFIG_JSON={"daily_cap_coins_per_plan":null,"high_floor":0.15}
REWARD_CONFIG_JSON=
